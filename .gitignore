# Captured request bodies contain the content of whatever documents were run.
out/
__pycache__/
*.egg-info/
.DS_Store

# The Claude Design source for the report's look. Kept out of the repo on
# purpose: it ships the commercial ABC Monument Grotesk woff2 files, which we
# deliberately do not redistribute, plus the canvas editor runtime. The design
# itself lives in Claude Design; theme.css carries the values we use.
branded-report/
branded-report.zip

# The internal paper trail: handoff note, specs, plans, execution ledgers,
# SDK defect write-ups and captured run bodies. Kept local on purpose. This
# repo goes to a named prospect under the Reference-Use licence, and the
# pre-publication audit greps tracked files for internal ticket ids and
# absolute paths, all of which live in here.
.internal/

# Credentials. This repo is handed to a named prospect under the Reference-Use
# licence, so a key committed here travels to them. The pre-publication audit
# greps tracked files; ignoring .env keeps it from ever becoming one.
.env
.env.*
!.env.example
